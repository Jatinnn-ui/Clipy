PORT=3000
# Directory containing owned/permitted source files named <YouTube video ID>.mp4.
AUTHORIZED_SOURCE_DIR=
# Optional yt-dlp executable override. Otherwise Clipy checks PATH and the Windows WinGet link.
YTDLP_PATH=
FFMPEG_PATH=
FFPROBE_PATH=
# Faster rendering default; use medium for slower, slightly more compression-efficient output.
FFMPEG_PRESET=veryfast
FFMPEG_CRF=21
# Optional local development fixture: <YouTube video ID>.words.json next to the MP4, with clip-relative timestamps.
# Kept server-side only. Used for word-level transcription when no .words.json sidecar exists.
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_URL=https://api.openai.com/v1/audio/transcriptions
